{
  "name": "@uptimewarden/cli",
  "version": "0.1.0",
  "description": "Monitoring-as-Code CLI for UptimeWarden: declare monitors in a JSON file and apply them from CI.",
  "license": "Apache-2.0",
  "author": "Zenigma",
  "homepage": "https://github.com/UptimeWarden/cli#readme",
  "bugs": {
    "url": "https://github.com/UptimeWarden/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UptimeWarden/cli.git"
  },
  "keywords": [
    "uptimewarden",
    "monitoring",
    "uptime",
    "monitoring-as-code",
    "cli"
  ],
  "type": "module",
  "bin": {
    "uw": "./dist/index.js",
    "uptimewarden": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --clean --shims --no-dts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p .",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
